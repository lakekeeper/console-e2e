# Mode: authn — OIDC authentication, NO authz backend (everyone authenticated is allowed).

# --- Backend (Lakekeeper) ---
LAKEKEEPER__PG_ENCRYPTION_KEY=abc
LAKEKEEPER__PG_DATABASE_URL_READ=postgresql://postgres:postgres@postgres:5432/postgres
LAKEKEEPER__PG_DATABASE_URL_WRITE=postgresql://postgres:postgres@postgres:5432/postgres
LAKEKEEPER__BASE_URI=http://localhost:8181
LAKEKEEPER__LISTEN_PORT=8181
LAKEKEEPER__ALLOW_ORIGIN=*
LAKEKEEPER__OPENID_PROVIDER_URI=http://host.docker.internal:30080/realms/iceberg
LAKEKEEPER__OPENID_ADDITIONAL_ISSUERS=http://localhost:30080/realms/iceberg
LAKEKEEPER__OPENID_AUDIENCE=lakekeeper
LAKEKEEPER__UI__OPENID_CLIENT_ID=lakekeeper
LAKEKEEPER__UI__OPENID_PROVIDER_URI=http://localhost:30080/realms/iceberg

# --- Frontend (Vite) ---
VITE_ENABLE_AUTHENTICATION=true
VITE_ENABLE_PERMISSIONS=false
VITE_APP_ICEBERG_CATALOG_URL=http://localhost:8181
VITE_BASE_URL_PREFIX=
VITE_IDP_AUTHORITY=http://localhost:30080/realms/iceberg/
VITE_IDP_CLIENT_ID=lakekeeper
VITE_IDP_REDIRECT_PATH=/callback
VITE_IDP_SCOPE=openid profile email lakekeeper
VITE_IDP_RESOURCE=
VITE_IDP_POST_LOGOUT_REDIRECT_PATH=/logout
VITE_IDP_TOKEN_TYPE=access_token

# Suppress the OSS user-survey popup during tests
VITE_ENABLE_USER_SURVEYS=false
